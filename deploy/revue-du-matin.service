# Passage quotidien de la Revue du matin (unité systemd utilisateur).
# Installation :
#   cp deploy/revue-du-matin.* ~/.config/systemd/user/
#   systemctl --user daemon-reload && systemctl --user enable --now revue-du-matin.timer
# Adapter WorkingDirectory si le dépôt n'est pas dans ~/workspace/faisseau.
[Unit]
Description=Revue du matin : collecte, regroupement, extraction, génération du site
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=%h/workspace/faisseau
Environment=PATH=%h/.local/bin:%h/.local/share/pnpm/bin:/usr/local/bin:/usr/bin
ExecStart=/usr/bin/make quotidien
# Pour publier dans la foulée : ExecStartPost=/usr/bin/make deployer
Nice=10
TimeoutStartSec=3h
