# En-têtes servis par Cloudflare (Pages ou Workers Static Assets).
# Le site n'exécute aucun script, ne charge rien d'un domaine tiers et ne pose aucun cookie.
# (« inline-speculation-rules » autorise seulement le préchargement des pages du site par le navigateur.)
/*
  Content-Security-Policy: default-src 'none'; script-src 'inline-speculation-rules'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'
  Referrer-Policy: no-referrer
  X-Content-Type-Options: nosniff
  Permissions-Policy: interest-cohort=(), browsing-topics=()
/_nuxt/*
  Cache-Control: public, max-age=31536000, immutable
