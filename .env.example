# Copier en .env (jamais versionné). Tout est optionnel.

# Fournisseur d'extraction des faits : mistral | koboldcpp | aucun
# (défaut : celui de config/reglages.yaml, mistral ; koboldcpp = repli local, jamais automatique)
# REVUE_LLM=koboldcpp

# Clé de l'API Mistral (https://console.mistral.ai)
# MISTRAL_API_KEY=

# Adresse de KoboldCpp si ce n'est pas http://localhost:5001/v1
# KOBOLDCPP_URL=http://localhost:5001/v1

# Modèle d'embeddings : solon | e5-small
# REVUE_EMBEDDINGS=solon
